{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "gopass",
  "title": "Gopass",
  "description": "Search and copy passwords from gopass password manager",
  "categories": [
    "Productivity",
    "Security"
  ],
  "icon": "icon.png",
  "author": "bake",
  "contributors": [
    "buchanan",
    "andy_fase"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Search Passwords",
      "subtitle": "Gopass",
      "description": "Search and copy passwords from gopass password manager",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.36.0",
    "@raycast/utils": "^1.18.1",
    "fuse.js": "^7.0.0",
    "otpauth": "^9.4.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "~16.10.0",
    "@types/react": "^19",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  },
  "platforms": [
    "macOS"
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml@3": "3.15.1",
    "fast-uri": "3.1.5"
  },
  "packageManager": "bun@1.4.2"
}
